---
import { GUARANTEES } from '@/data/content';
---

<section id="seccion-garantias" class="w-full px-4 sm:px-6 py-12 bg-slate-100">
  <div class="max-w-3xl mx-auto flex flex-col gap-6">
    <!-- Header de Sección -->
    <div class="flex flex-col gap-1">
      <span class="text-xs font-extrabold uppercase tracking-wider text-brand-orange">
        RESPALDO TOTAL
      </span>
      <h2 class="text-2xl sm:text-3xl text-brand-marine uppercase font-black tracking-tight">
        TRANQUILIDAD Y SEGURIDAD
      </h2>
      <p class="text-sm text-slate-600">
        Cumplimiento estricto con los estándares de traslado vehicular y respaldo fiscal en Argentina.
      </p>
    </div>

    <!-- Lista de Garantías -->
    <div class="flex flex-col gap-3 sm:gap-4">
      {GUARANTEES.map((item) => (
        <div class="p-5 rounded-2xl bg-white flex items-start gap-4 shadow-sm border border-slate-200">
          <div class="w-11 h-11 rounded-xl bg-slate-100 flex items-center justify-center text-brand-marine flex-shrink-0">
            {item.icon === 'receipt' && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-brand-orange" aria-hidden="true">
                <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z" />
                <path d="M14 8H8" />
                <path d="M16 12H8" />
                <path d="M13 16H8" />
              </svg>
            )}
            {item.icon === 'share-location' && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-brand-orange" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <circle cx="12" cy="12" r="3" />
                <line x1="12" y1="2" x2="12" y2="5" />
                <line x1="12" y1="19" x2="12" y2="22" />
                <line x1="2" y1="12" x2="5" y2="12" />
                <line x1="19" y1="12" x2="22" y2="12" />
              </svg>
            )}
            {item.icon === 'shield-check' && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-brand-orange" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                <path d="m9 12 2 2 4-4" />
              </svg>
            )}
          </div>

          <div class="flex flex-col">
            <h3 class="text-base sm:text-lg text-brand-marine font-black uppercase leading-snug">
              {item.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
