---
import { SERVICES, CONTACT_INFO } from '@/data/content';
---

<section id="seccion-servicios" class="w-full px-4 sm:px-6 py-12 bg-surface-white">
  <div class="max-w-3xl mx-auto flex flex-col gap-6">
    <!-- Header de Sección -->
    <div class="flex flex-col gap-1">
      <span class="text-xs font-extrabold uppercase tracking-wider text-brand-orange">
        SOLUCIONES OPERATIVAS
      </span>
      <h2 class="text-2xl sm:text-3xl text-brand-marine uppercase font-black tracking-tight">
        SERVICIOS ESPECIALIZADOS
      </h2>
      <p class="text-sm text-slate-600">
        Unidad autónoma polivalente lista para resolver emergencias mecánicas y traslados seguros.
      </p>
    </div>

    <!-- Grid de 4 Servicios -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {SERVICES.map((service) => {
        const whatsappUrl = `https://wa.me/${CONTACT_INFO.rawPhone}?text=${encodeURIComponent(service.whatsappMessage)}`;

        return (
          <article
            class="w-full rounded-2xl bg-brand-lightblue text-brand-marine p-5 sm:p-6 flex flex-col justify-between gap-5 shadow-sm border border-brand-lightblue/50 hover:shadow-md transition-shadow"
          >
            <div class="flex flex-col gap-3">
              <div class="flex items-center justify-between">
                <div class="w-10 h-10 rounded-xl bg-brand-marine text-white flex items-center justify-center flex-shrink-0 shadow-sm">
                  {service.icon === 'tow-truck' && (
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-brand-orange" aria-hidden="true">
                      <path d="M10 17h4V5H2v12h3" />
                      <path d="M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5" />
                      <path d="M14 17h1" />
                      <circle cx="7.5" cy="17.5" r="2.5" />
                      <circle cx="17.5" cy="17.5" r="2.5" />
                    </svg>
                  )}
                  {service.icon === 'battery-charging' && (
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-brand-orange" aria-hidden="true">
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                    </svg>
                  )}
                  {service.icon === 'tire' && (
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-brand-orange" aria-hidden="true">
                      <circle cx="12" cy="12" r="10" />
                      <circle cx="12" cy="12" r="4" />
                      <line x1="12" y1="2" x2="12" y2="8" />
                      <line x1="12" y1="16" x2="12" y2="22" />
                      <line x1="2" y1="12" x2="8" y2="12" />
                      <line x1="16" y1="12" x2="22" y2="12" />
                    </svg>
                  )}
                  {service.icon === 'wrench' && (
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-brand-orange" aria-hidden="true">
                      <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                    </svg>
                  )}
                </div>

                <span class="px-2.5 py-1 rounded-md bg-brand-marine text-white text-[11px] font-black uppercase tracking-wider">
                  {service.badge}
                </span>
              </div>

              <h3 class="text-lg font-black uppercase tracking-tight text-brand-marine leading-snug">
                {service.title}
              </h3>

              <p class="text-xs sm:text-sm text-brand-marine/85 font-medium leading-relaxed">
                {service.description}
              </p>

              {service.disclaimer && (
                <div class="mt-1 px-2.5 py-1.5 rounded-lg bg-brand-marine/10 self-start border border-brand-marine/15">
                  <span class="text-[11px] font-bold text-brand-marine uppercase">
                    {service.disclaimer}
                  </span>
                </div>
              )}
            </div>

            <a
              id={`btn-pedir-servicio-${service.id}`}
              href={whatsappUrl}
              class="w-full h-11 rounded-xl bg-brand-marine hover:bg-[#1b3452] active:scale-[0.99] text-white flex items-center justify-between px-4 text-xs sm:text-sm font-bold uppercase tracking-wider shadow-sm transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-orange"
            >
              <span>{service.ctaText}</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-brand-orange" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          </article>
        );
      })}
    </div>
  </div>
</section>
