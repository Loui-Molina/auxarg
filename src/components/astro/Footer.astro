---
import { CONTACT_INFO } from '@/data/content';
---

<footer
  id="seccion-footer"
  class="w-full bg-brand-marine text-white px-4 sm:px-6 pt-10 pb-28 sm:pb-12 border-t border-white/10"
>
  <div class="max-w-3xl mx-auto flex flex-col gap-6">
    <!-- Brand Header -->
    <div class="flex items-center justify-between">
      <div class="flex flex-col">
        <span class="text-xl sm:text-2xl uppercase font-black text-white tracking-tight">
          {CONTACT_INFO.brandName}
        </span>
        <span class="text-xs text-brand-lightblue uppercase tracking-wider font-semibold">
          {CONTACT_INFO.brandTagline}
        </span>
      </div>
      <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-brand-orange border border-white/10">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-5 h-5"
          aria-hidden="true"
        >
          <path d="M10 17h4V5H2v12h3" />
          <path d="M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5" />
          <path d="M14 17h1" />
          <circle cx="7.5" cy="17.5" r="2.5" />
          <circle cx="17.5" cy="17.5" r="2.5" />
        </svg>
      </div>
    </div>

    <!-- Contact & Details -->
    <div class="flex flex-col gap-2.5">
      <a
        id="btn-llamar-footer"
        href={CONTACT_INFO.telUrl}
        class="inline-flex items-center gap-2 text-white font-bold text-base sm:text-lg hover:text-brand-orange transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-5 h-5 text-brand-orange"
          aria-hidden="true"
        >
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
          />
        </svg>
        <span>{CONTACT_INFO.displayPhone}</span>
      </a>

      <div class="flex items-center gap-2 text-slate-300 text-xs sm:text-sm">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-4 h-4 text-brand-lightblue flex-shrink-0"
          aria-hidden="true"
        >
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        <span>{CONTACT_INFO.baseLocation}</span>
      </div>

      <div class="flex items-center gap-2 text-brand-lightblue text-xs sm:text-sm font-medium">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-4 h-4 text-brand-lightblue flex-shrink-0"
          aria-hidden="true"
        >
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          <path d="m9 12 2 2 4-4" />
        </svg>
        <span>1 Unidad Operativa Equipada • Trato Directo sin Intermediarios</span>
      </div>
    </div>

    <div class="w-full h-px bg-white/10 my-1"></div>

    <div class="flex items-center justify-between text-xs text-slate-400 font-medium">
      <span>© 2026 AUXILIO ARGENTINO</span>
      <span class="uppercase">Córdoba, ARG</span>
    </div>
  </div>
</footer>
